# D365 Demo Environment Configuration
# Copy this file to .env and update with your values

# Azure Configuration
AZURE_SUBSCRIPTION_ID="9019cfb1-cb52-4c48-a0a8-727ad3933f34"
AZURE_TENANT_ID="DE353337165"
AZURE_LOCATION="westeurope"
RESOURCE_GROUP_NAME="rg-d365-demo"
RESOURCE_PREFIX="d365demo"

# Azure AD App Registration
APP_REGISTRATION_CLIENT_ID="your-app-client-id"
APP_REGISTRATION_CLIENT_SECRET="your-client-secret"
APP_REGISTRATION_AUDIENCE="api://your-app-client-id"

# D365 Finance & Operations (Optional - leave empty for mock)
D365_HOST_URL="https://your-d365-sandbox.com"
D365_ACCESS_TOKEN="your-d365-access-token"

# APIM Configuration
APIM_RATE_LIMIT_CALLS=60
APIM_RATE_LIMIT_RENEWAL_SECONDS=60
